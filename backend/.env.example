# 复制为 backend/.env 并填入密钥（勿提交仓库）

# --- LLM（OpenAI 兼容端 → DeepSeek）---
# 官方文档：https://api-docs.deepseek.com/
LLM_BINDING=openai
LLM_MODEL=deepseek-v4-pro
LLM_BINDING_API_KEY=your-deepseek-api-key
LLM_BINDING_HOST=https://api.deepseek.com

# 分场景可与全局一致； host 勿带路径后缀（后端会拼 /chat/completions）
# KG_LLM_BINDING=openai
# KG_LLM_MODEL=deepseek-v4-pro
# KG_LLM_BINDING_HOST=https://api.deepseek.com
# CHAT_LLM_BINDING=openai
# CHAT_LLM_MODEL=deepseek-v4-pro
# CHAT_LLM_BINDING_HOST=https://api.deepseek.com

# DeepSeek 脚本 / capture 用（可选，与 LLM_BINDING_API_KEY 可相同）
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-pro

# Claude Code / Anthropic SDK → DeepSeek（仅本地工具链；StudyForge 后端仍用上方 OpenAI 兼容 URL）
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_MODEL=deepseek-v4-pro

# --- 向量嵌入（通常仍为硅基流动或本地 Ollama；勿指向 api.deepseek.com 除非你有兼容的 embeddings）---
EMBEDDING_BINDING=siliconflow
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024
EMBEDDING_BINDING_HOST=https://api.siliconflow.cn/v1

# 其他配置（可选）
MAX_ASYNC=16
TIMEOUT=400
IMAGE_RESOLUTION=150
MAX_FILE_SIZE=52428800
MAX_FILES_PER_CONVERSATION=20

# HTTP 网关（可选）
STUDYFORGE_API_KEY=
# AFE_API_KEY=
